{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "singleAttributePerLine": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "db",
    "**/fallbacks.css",
    "**/sprites-36x48-*.css",
    "**/sprites-72x96-*.css",
    "**/breed-definitions.ts",
    "process-breeds/*breeds.json",
    "package.json",
    "package-lock.json"
  ]
}
